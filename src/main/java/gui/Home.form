<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="gui.Home">
  <grid id="mainPanel" binding="mainPanel" layout-manager="GridLayoutManager" row-count="5" column-count="1">
    <border type="none"/>
    <margin top="20" left="20" bottom="20" right="20"/>
    <constraints>
      <xy x="20" y="20" width="400" height="300"/>
    </constraints>

    <children>

      <component id="btnVeicoli" class="javax.swing.JButton" binding="btnVeicoli">
        <properties><text>Auto</text></properties>
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1"
                vsize-policy="0" hsize-policy="0" anchor="0" fill="1"/>
        </constraints>
      </component>

      <component id="btnClienti" class="javax.swing.JButton" binding="btnClienti">
        <properties><text>Clienti</text></properties>
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1"
                vsize-policy="0" hsize-policy="0" anchor="0" fill="1"/>
        </constraints>
      </component>

      <component id="btnNoleggi" class="javax.swing.JButton" binding="btnNoleggi">
        <properties><text>Noleggi</text></properties>
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1"
                vsize-policy="0" hsize-policy="0" anchor="0" fill="1"/>
        </constraints>
      </component>

      <component id="btnScooter" class="javax.swing.JButton" binding="btnScooter">
        <properties><text>Scooter</text></properties>
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1"
                vsize-policy="0" hsize-policy="0" anchor="0" fill="1"/>
        </constraints>
      </component>

      <component id="btnPagamento" class="javax.swing.JButton" binding="btnPagamento">
        <properties><text>Pagamenti</text></properties>
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="1"
                vsize-policy="0" hsize-policy="0" anchor="0" fill="1"/>
        </constraints>
      </component>

    </children>

  </grid>
</form>
