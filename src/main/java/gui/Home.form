<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="gui.Home">
  <grid id="mainGrid" binding="mainPanel" layout-manager="GridLayoutManager" row-count="3" column-count="2"
        same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="10">
    <margin top="20" left="20" bottom="20" right="20"/>

    <constraints>
      <xy x="20" y="20" width="600" height="400"/>
    </constraints>

    <properties/>
    <border type="none"/>

    <children>
	
      <component id="btnVeicoli" class="javax.swing.JButton" binding="btnVeicoli">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1"/>
        </constraints>
        <properties>
          <text value="Veicoli"/>
        </properties>
      </component>

      <component id="btnClienti" class="javax.swing.JButton" binding="btnClienti">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1"/>
        </constraints>
        <properties>
          <text value="Clienti"/>
        </properties>
      </component>

      <component id="btnNoleggi" class="javax.swing.JButton" binding="btnNoleggi">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="0" fill="1"/>
        </constraints>
        <properties>
          <text value="Noleggi"/>
        </properties>
      </component>

      <component id="btnPagamenti" class="javax.swing.JButton" binding="btnPagamenti">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1"/>
        </constraints>
        <properties>
          <text value="Pagamenti"/>
        </properties>
      </component>

      <component id="btnManutenzioni" class="javax.swing.JButton" binding="btnManutenzioni">
        <constraints>
          <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1"/>
        </constraints>
        <properties>
          <text value="Manutenzioni"/>
        </properties>
      </component>

    </children>
  </grid>
</form>