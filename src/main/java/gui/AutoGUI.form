<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="gui.AutoGUI">
  <grid id="napoli" binding="napoli" layout-manager="GridLayoutManager" row-count="2" column-count="1">
    <border type="none"/>
    <margin top="10" left="10" bottom="10" right="10"/>
    <constraints>
      <xy x="20" y="20" width="700" height="500"/>
    </constraints>

    <children>

      <!-- TABELLA AUTO -->
      <component id="tabellaAuto" class="javax.swing.JTable" binding="tabellaAuto">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1"
                vsize-policy="6" hsize-policy="6" anchor="0" fill="3"/>
        </constraints>
      </component>

      <!-- PANNELLO PULSANTI -->
      <grid id="panelButtons" layout-manager="GridLayoutManager" row-count="1" column-count="6">
        <border type="none"/>
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1"
                vsize-policy="0" hsize-policy="6" anchor="0" fill="3"/>
        </constraints>

        <children>

          <component id="pulsanteAggiungiAuto" class="javax.swing.JButton" binding="pulsanteAggiungiAuto">
            <properties><text>Aggiungi</text></properties>
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1"
                    vsize-policy="0" hsize-policy="0" anchor="0" fill="1"/>
            </constraints>
          </component>

          <component id="pulsanteModificaAuto" class="javax.swing.JButton" binding="pulsanteModificaAuto">
            <properties><text>Modifica</text></properties>
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1"
                    vsize-policy="0" hsize-policy="0" anchor="0" fill="1"/>
            </constraints>
          </component>

          <component id="pulsanteEliminaAuto" class="javax.swing.JButton" binding="pulsanteEliminaAuto">
            <properties><text>Elimina</text></properties>
            <constraints>
              <grid row="0" column="2" row-span="1" col-span="1"
                    vsize-policy="0" hsize-policy="0" anchor="0" fill="1"/>
            </constraints>
          </component>

          <component id="pulsanteCambiaStatoAuto" class="javax.swing.JButton" binding="pulsanteCambiaStatoAuto">
            <properties><text>Cambia Stato</text></properties>
            <constraints>
              <grid row="0" column="3" row-span="1" col-span="1"
                    vsize-policy="0" hsize-policy="0" anchor="0" fill="1"/>
            </constraints>
          </component>

          <component id="pulsanteMostraNoleggiAuto" class="javax.swing.JButton" binding="pulsanteMostraNoleggiAuto">
            <properties><text>Noleggi</text></properties>
            <constraints>
              <grid row="0" column="4" row-span="1" col-span="1"
                    vsize-policy="0" hsize-policy="0" anchor="0" fill="1"/>
            </constraints>
          </component>

          <component id="pulsanteIndietro" class="javax.swing.JButton" binding="pulsanteIndietro">
            <properties><text>Indietro</text></properties>
            <constraints>
              <grid row="0" column="5" row-span="1" col-span="1"
                    vsize-policy="0" hsize-policy="0" anchor="0" fill="1"/>
            </constraints>
          </component>

        </children>
      </grid>

    </children>

  </grid>
</form>
