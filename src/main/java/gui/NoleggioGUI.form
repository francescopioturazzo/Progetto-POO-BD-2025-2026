<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="gui.NoleggioGUI">
  <grid id="mainPanel" binding="mainPanel" layout-manager="GridLayoutManager" row-count="2" column-count="1">
    <border type="none"/>
    <margin top="10" left="10" bottom="10" right="10"/>
    <constraints>
      <xy x="20" y="20" width="700" height="500"/>
    </constraints>

    <children>

      <!-- TABELLA NOLEGGI -->
      <component id="tabellaNoleggi" class="javax.swing.JTable" binding="tabellaNoleggi">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1"
                vsize-policy="6" hsize-policy="6" anchor="0" fill="3"/>
        </constraints>
      </component>

      <!-- PANNELLO PULSANTI -->
      <grid id="panelButtons" layout-manager="GridLayoutManager" row-count="1" column-count="6">
        <border type="none"/>
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1"
                vsize-policy="0" hsize-policy="6" anchor="0" fill="3"/>
        </constraints>

        <children>

          <component id="pulsanteAggiungiNoleggio" class="javax.swing.JButton" binding="pulsanteAggiungiNoleggio">
            <properties><text>Aggiungi</text></properties>
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1"
                    vsize-policy="0" hsize-policy="0" anchor="0" fill="1"/>
            </constraints>
          </component>

          <component id="pulsanteModificaNoleggio" class="javax.swing.JButton" binding="pulsanteModificaNoleggio">
            <properties><text>Modifica</text></properties>
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1"
                    vsize-policy="0" hsize-policy="0" anchor="0" fill="1"/>
            </constraints>
          </component>

          <component id="pulsanteEliminaNoleggio" class="javax.swing.JButton" binding="pulsanteEliminaNoleggio">
            <properties><text>Elimina</text></properties>
            <constraints>
              <grid row="0" column="2" row-span="1" col-span="1"
                    vsize-policy="0" hsize-policy="0" anchor="0" fill="1"/>
            </constraints>
          </component>

          <component id="pulsanteMostraCliente" class="javax.swing.JButton" binding="pulsanteMostraCliente">
            <properties><text>Cliente</text></properties>
            <constraints>
              <grid row="0" column="3" row-span="1" col-span="1"
                    vsize-policy="0" hsize-policy="0" anchor="0" fill="1"/>
            </constraints>
          </component>

          <component id="pulsanteMostraVeicolo" class="javax.swing.JButton" binding="pulsanteMostraVeicolo">
            <properties><text>Veicolo</text></properties>
            <constraints>
              <grid row="0" column="4" row-span="1" col-span="1"
                    vsize-policy="0" hsize-policy="0" anchor="0" fill="1"/>
            </constraints>
          </component>

          <component id="pulsanteIndietro" class="javax.swing.JButton" binding="pulsanteIndietro">
            <properties><text>Indietro</text></properties>
            <constraints>
              <grid row="0" column="5" row-span="1" col-span="1"
                    vsize-policy="0" hsize-policy="0" anchor="0" fill="1"/>
            </constraints>
          </component>

        </children>
      </grid>

    </children>

  </grid>
</form>
