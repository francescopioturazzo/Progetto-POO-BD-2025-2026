<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="gui.Auto">
  <grid id="root" binding="napoli" layout-manager="GridLayoutManager"
        row-count="7" column-count="7" same-size-horizontally="false" same-size-vertically="false"
        hgap="5" vgap="5">

    <margin top="10" left="10" bottom="10" right="10"/>
    <constraints>
      <xy x="20" y="20" width="700" height="400"/>
    </constraints>

    <properties/>
    <border type="none"/>

    <children>

      <!-- INTESTAZIONI -->
      <component id="colId" class="javax.swing.JLabel">
        <constraints><grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="1" fill="0"/></constraints>
        <properties><text value="ID"/></properties>
      </component>

      <component id="colTarga" class="javax.swing.JLabel">
        <constraints><grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="1" fill="0"/></constraints>
        <properties><text value="Targa"/></properties>
      </component>

      <component id="colMarca" class="javax.swing.JLabel">
        <constraints><grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="1" fill="0"/></constraints>
        <properties><text value="Marca"/></properties>
      </component>

      <component id="colModello" class="javax.swing.JLabel">
        <constraints><grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="1" fill="0"/></constraints>
        <properties><text value="Modello"/></properties>
      </component>

      <component id="colPorte" class="javax.swing.JLabel">
        <constraints><grid row="0" column="4" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="1" fill="0"/></constraints>
        <properties><text value="Porte"/></properties>
      </component>

      <component id="colAlim" class="javax.swing.JLabel">
        <constraints><grid row="0" column="5" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="1" fill="0"/></constraints>
        <properties><text value="Alimentazione"/></properties>
      </component>

      <component id="colStato" class="javax.swing.JLabel">
        <constraints><grid row="0" column="6" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="1" fill="0"/></constraints>
        <properties><text value="Stato"/></properties>
      </component>

      <!-- RIGA 1 -->
      <component id="r1c1" class="javax.swing.JLabel">
        <constraints><grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="1" fill="0"/></constraints>
        <properties><text value=""/></properties>
      </component>

      <component id="r1c2" class="javax.swing.JLabel">
        <constraints><grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="1" fill="0"/></constraints>
        <properties><text value=""/></properties>
      </component>

      <component id="r1c3" class="javax.swing.JLabel">
        <constraints><grid row="1" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="1" fill="0"/></constraints>
        <properties><text value=""/></properties>
      </component>

      <component id="r1c4" class="javax.swing.JLabel">
        <constraints><grid row="1" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="1" fill="0"/></constraints>
        <properties><text value=""/></properties>
      </component>

      <component id="r1c5" class="javax.swing.JLabel">
        <constraints><grid row="1" column="4" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="1" fill="0"/></constraints>
        <properties><text value=""/></properties>
      </component>

      <component id="r1c6" class="javax.swing.JLabel">
        <constraints><grid row="1" column="5" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="1" fill="0"/></constraints>
        <properties><text value=""/></properties>
      </component>

      <component id="r1c7" class="javax.swing.JLabel">
        <constraints><grid row="1" column="6" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="1" fill="0"/></constraints>
        <properties><text value=""/></properties>
      </component>

      <!-- BACK -->
      <component id="backButton" class="javax.swing.JButton" binding="back">
        <constraints><grid row="6" column="0" row-span="1" col-span="7" vsize-policy="0" hsize-policy="3" anchor="0" fill="1"/></constraints>
        <properties><text value="Indietro"/></properties>
      </component>

    </children>
  </grid>
</form>
